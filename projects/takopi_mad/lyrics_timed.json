[
 {
  "i": 0,
  "text": "旁人不掩的冷漠",
  "start": 25.02,
  "end": 28.02,
  "parts": null
 },
 {
  "i": 1,
  "text": "扬唇讽我执着",
  "start": 28.02,
  "end": 31.14,
  "parts": null
 },
 {
  "i": 2,
  "text": "抹杀最后的虚弱",
  "start": 31.14,
  "end": 36.96,
  "parts": null
 },
 {
  "i": 3,
  "text": "挣扎中迷失自我",
  "start": 36.96,
  "end": 40.06,
  "parts": null
 },
 {
  "i": 4,
  "text": "黑暗逐渐吞没",
  "start": 40.06,
  "end": 43.1,
  "parts": null
 },
 {
  "i": 5,
  "text": "胸中残存的余热",
  "start": 43.1,
  "end": 47.32,
  "parts": null
 },
 {
  "i": 6,
  "text": "谁笑着 似哭了 挣扎着 麻木了",
  "start": 47.32,
  "end": 53.88,
  "parts": [
   47.32,
   49.12,
   50.38,
   52.42
  ]
 },
 {
  "i": 7,
  "text": "刀划破血肉竟如此快活",
  "start": 53.88,
  "end": 59.52,
  "parts": null
 },
 {
  "i": 8,
  "text": "麻木地行走着不如木偶",
  "start": 59.52,
  "end": 64.34,
  "parts": null
 },
 {
  "i": 9,
  "text": "不予借口辩驳",
  "start": 64.34,
  "end": 67.08,
  "parts": null
 },
 {
  "i": 10,
  "text": "如何做个哑巴苟活",
  "start": 67.08,
  "end": 71.52,
  "parts": null
 },
 {
  "i": 11,
  "text": "绝望的藤蔓生于指尖交错",
  "start": 71.52,
  "end": 77.84,
  "parts": null
 },
 {
  "i": 12,
  "text": "逐渐吞噬不堪重负的躯壳",
  "start": 77.84,
  "end": 83.48,
  "parts": null
 },
 {
  "i": 13,
  "text": "嘶吼着试图驱逐心里的魔",
  "start": 83.48,
  "end": 89.38,
  "parts": null
 },
 {
  "i": 14,
  "text": "殊不知灵魂早已被妖魔胁迫",
  "start": 89.38,
  "end": 95.6,
  "parts": null
 },
 {
  "i": 15,
  "text": "觊觎着 不得的自由",
  "start": 95.6,
  "end": 100.28,
  "parts": [
   95.6,
   97.4
  ]
 },
 {
  "i": 16,
  "text": "谁言语淬毒 封锁我歌喉",
  "start": 100.28,
  "end": 107.2,
  "parts": [
   100.28,
   103.86
  ]
 },
 {
  "i": 17,
  "text": "孤独已将我吞没",
  "start": 108.96,
  "end": 112.12,
  "parts": null
 },
 {
  "i": 18,
  "text": "为掩心底无措",
  "start": 112.12,
  "end": 115.12,
  "parts": null
 },
 {
  "i": 19,
  "text": "于人前故作淡漠",
  "start": 115.12,
  "end": 120.62,
  "parts": null
 },
 {
  "i": 20,
  "text": "狂奔着捂住耳朵",
  "start": 120.62,
  "end": 124.08,
  "parts": null
 },
 {
  "i": 21,
  "text": "奢求就此逃脱",
  "start": 124.08,
  "end": 127.1,
  "parts": null
 },
 {
  "i": 22,
  "text": "如蛆附骨的折磨",
  "start": 127.1,
  "end": 131.8,
  "parts": null
 },
 {
  "i": 23,
  "text": "肆意地 发泄着 咆哮着 毁灭了",
  "start": 131.8,
  "end": 137.58,
  "parts": [
   131.8,
   133.6,
   134.64,
   136.46
  ]
 },
 {
  "i": 24,
  "text": "与这深渊拼个鱼死网破",
  "start": 137.58,
  "end": 143.42,
  "parts": null
 },
 {
  "i": 25,
  "text": "像地底蝼蚁在自我撕扯",
  "start": 143.42,
  "end": 148.26,
  "parts": null
 },
 {
  "i": 26,
  "text": "深陷绝望漩涡",
  "start": 148.26,
  "end": 151.0,
  "parts": null
 },
 {
  "i": 27,
  "text": "谁能说破孰对孰错",
  "start": 151.0,
  "end": 155.32,
  "parts": null
 },
 {
  "i": 28,
  "text": "只窥得世人心中纲常丑恶",
  "start": 155.32,
  "end": 161.66,
  "parts": null
 },
 {
  "i": 29,
  "text": "彻底沦为腐化败坏的偏颇",
  "start": 161.66,
  "end": 169.42,
  "parts": null
 },
 {
  "i": 30,
  "text": "高空坠落当作赌注以搏",
  "start": 169.42,
  "end": 172.96,
  "parts": null
 },
 {
  "i": 31,
  "text": "能否交换夺过",
  "start": 172.96,
  "end": 175.6,
  "parts": null
 },
 {
  "i": 32,
  "text": "挣扎叛逆却不能得",
  "start": 175.6,
  "end": 179.04,
  "parts": null
 },
 {
  "i": 33,
  "text": "渺茫的洒脱",
  "start": 179.04,
  "end": 184.0,
  "parts": null
 },
 {
  "i": 34,
  "text": "如困兽在夹缝中辗转流落",
  "start": 191.26,
  "end": 197.54,
  "parts": null
 },
 {
  "i": 35,
  "text": "倘若选择死亡是否能解脱",
  "start": 197.54,
  "end": 203.44,
  "parts": null
 },
 {
  "i": 36,
  "text": "跃下后形同小丑躺在血泊",
  "start": 203.44,
  "end": 209.46,
  "parts": null
 },
 {
  "i": 37,
  "text": "微弱呼救却被笑声所淹没",
  "start": 209.46,
  "end": 215.54,
  "parts": null
 },
 {
  "i": 38,
  "text": "放弃吧 认清这结果",
  "start": 215.54,
  "end": 220.28,
  "parts": [
   215.54,
   218.0
  ]
 },
 {
  "i": 39,
  "text": "但 伏诛俗世 唯 死以解脱",
  "start": 220.28,
  "end": 227.4,
  "parts": [
   220.28,
   221.6,
   223.4,
   224.4
  ]
 }
]